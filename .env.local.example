# Local dev (docker-compose): matches docker-compose.yml's db service.
# Production (Vercel): paste the connection string from Neon/Supabase instead.
DATABASE_URL="postgres://cafeos:cafeos@localhost:5433/cafeos"

# console.groq.com -> API Keys
GROQ_API_KEY="your-groq-api-key"

# Any long random string -- used to sign staff login session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"
